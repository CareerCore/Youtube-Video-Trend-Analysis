display(df.head())\n\n\n# ## 2. Schema and feature construction\n# \n# The dataset contains repeated daily observations for videos that remain on the trending list. We create descriptive features from publication and trending timestamps, title/tags, and engagement counts. The performance metrics are kept separate from the pre-performance metadata used by the benchmark model.\n\n\nexpected=['video_id','trending_date','title','channel_title','category_id','publish_time','tags','views','likes','dislikes','comment_count','thumbnail_link','comments_disabled','ratings_disabled','video_error_or_removed','description','region']; assert list(df.columns)==expected; df["trending_date_parsed"]=pd.to_datetime(df.trending_date,format="%y.%d.%m",errors="coerce"); df["publish_dt"]=pd.to_datetime(df.publish_time,errors="coerce",utc=True); assert df.publish_dt.notna().all(); df["days_to_trend"]=(df.trending_date_parsed.dt.tz_localize("UTC")-df.publish_dt.dt.normalize()).dt.total_seconds()/86400; df["title_chars"]=df.title.fillna("").str.len(); df["title_words"]=df.title.fillna("").str.split().str.len(); df["tag_count"]=df.tags.fillna("").replace("[none]","").str.count("\|")+df.tags.fillna("").ne(""); df["publish_hour"]=df.publish_dt.dt.hour; df["like_rate"]=df.likes/df.views.replace(0,np.nan); df["comment_rate"]=df.comment_count/df.views.replace(0,np.nan); df=df.replace([np.inf,-np.inf],np.nan); print("Rows:",len(df),"| unique videos:",df.video_id.nunique(),"| duplicate rows:",int(df.duplicated().sum())); display(df[['views','likes','comment_count','days_to_trend','title_chars','like_rate','comment_rate']].describe(percentiles=[.1,.5,.9,.99]).round(4))\n\n\n# ## 3. What appears on the trending list?\n# \n# The first view is descriptive: a trending-list appearance is not the same as total platform popularity. Category IDs are retained because the JSON category maps vary by region; the notebook compares regions and the most frequent IDs without inventing labels.\n\n\nregion_stats=df.groupby("region").agg(records=("video_id","size"),unique_videos=("video_id","nunique"),median_views=("views","median"),median_like_rate=("like_rate","median")).round(4); display(region_stats); cat=df.groupby(["region","category_id"]).agg(records=("video_id","size"),median_views=("views","median"),median_like_rate=("like_rate","median")).reset_index(); top_cat=cat.sort_values(["region","records"],ascending=[True,False]).groupby("region").head(8); display(top_cat.round(4)); plt.figure(figsize=(10,6)); sns.countplot(data=df,y="category_id",hue="region",order=df.category_id.value_counts().head(12).index); plt.title("Most frequent category IDs in selected regions"); plt.xlabel("trending-list records"); plt.ylabel("category_id"); plt.tight_layout(); plt.show()\n\n\n# ## 4. Engagement: rates matter more than raw counts\n# \n# Raw views favor large channels and older videos. Like rate and comment rate provide a different lens, although they are also affected by audience mix, video format, and whether viewers are asked to interact. Extreme ratios are not interpreted as causal.\n\n\nplot=df.dropna(subset=["like_rate","comment_rate"]).copy(); plot=plot[(plot.like_rate<=plot.like_rate.quantile(.99))&(plot.comment_rate<=plot.comment_rate.quantile(.99))]; fig,ax=plt.subplots(1,2,figsize=(16,5)); sns.scatterplot(data=plot.sample(min(12000,len(plot)),random_state=42),x="views",y="likes",hue="region",alpha=.35,ax=ax[0]); ax[0].set_xscale("log"); ax[0].set_yscale("log"); ax[0].set_title("Views versus likes, log scale"); sns.boxplot(data=plot,x="region",y="like_rate",ax=ax[1],color="#9CC4B2"); ax[1].set_ylim(0,plot.like_rate.quantile(.98)); ax[1].set_title("Like rate by region, trimmed"); ax[1].set_ylabel("likes / views"); plt.tight_layout(); plt.show(); display(df.groupby("region")["like_rate"].agg(["count","median","mean"]).round(4))\n\n\n# ## 5. Timing and title patterns\n# \n# A creator can control publishing choices, but the dataset cannot prove that a particular hour or title length causes trending. We compare distributions and medians only. `days_to_trend` is a rough interval because the daily trending date is not an exact recommendation timestamp.\n\n\ntiming=df.groupby("publish_hour").agg(records=("video_id","size"),median_views=("views","median"),median_like_rate=("like_rate","median")).reset_index(); fig,ax=plt.subplots(1,2,figsize=(16,5)); sns.lineplot(data=timing,x="publish_hour",y="records",marker="o",ax=ax[0],color="#355070"); ax[0].set_title("Trending records by UTC publish hour"); sns.boxplot(data=df,x="region",y="days_to_trend",ax=ax[1],color="#C2D4D8"); ax[1].set_ylim(-1,df.days_to_trend.quantile(.98)); ax[1].set_title("Approximate days from publish to trend"); plt.tight_layout(); plt.show(); print("Title length medians by region:"); display(df.groupby("region")["title_chars"].agg(["count","median","mean"]).round(1))\n\n\n# ## 6. Leakage-safe high-engagement benchmark\n# \n# The target is whether a record’s like rate is at or above the training-set median. The model uses only metadata plausibly available before performance is observed: region, category, publish hour, title length, title word count, tag count, and comments-disabled status. Views, likes, dislikes, comment count, and the target-derived rates are excluded.\n\n\nfeatures=["region","category_id","publish_hour","title_chars","title_words","tag_count","comments_disabled"]; work=df.dropna(subset=["like_rate"]+features).copy(); tr,te=train_test_split(np.arange(len(work)),test_size=.25,random_state=42); cutoff=work.iloc[tr].like_rate.median(); y=(work.like_rate>=cutoff).astype(int); cat=["region","category_id"]; num=["publish_hour","title_chars","title_words","tag_count","comments_disabled"]; pre=ColumnTransformer([("cat",Pipeline([("impute",SimpleImputer(strategy="most_frequent")),("onehot",OneHotEncoder(handle_unknown="ignore",min_frequency=3))]),cat),("num",Pipeline([("impute",SimpleImputer(strategy="median")),("scale",StandardScaler())]),num)]); model=Pipeline([("prep"